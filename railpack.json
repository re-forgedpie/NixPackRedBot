{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "preDeployCommand": "redbot-setup --no-prompt --instance-name mydiscordbot --backend json --data-path /var/lib/Red-DiscordBot/data",
    "startCommand": "redbot mydiscordbot --no-prompt --token $DISCORD_TOKEN -p $DISCORD_PREFIX $ADDITIONAL_LAUNCH_ARGS"
  }
}
